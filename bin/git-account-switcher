#!/usr/bin/env bash
# ==============================================================================
# git-account-switcher (gswitch) - Fast Multi-Account GitHub & Git Switcher
# Native POSIX Bash for macOS, Linux, and Windows (Git Bash/WSL)
# ==============================================================================

# If running in Windows Git Bash and powershell.exe is available, delegate to powershell
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]] && command -v powershell.exe >/dev/null 2>&1; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/git-account-switcher.ps1" "$@"
fi

CONFIG_DIR="$HOME/.config/git-account-switcher"
CONFIG_FILE="$CONFIG_DIR/accounts.json"

show_status() {
    local active_gh
    active_gh=$(gh api user --jq '.login' 2>/dev/null || echo "(none / not logged in)")
    local global_name
    global_name=$(git config --global user.name 2>/dev/null || echo "(not set)")
    local global_email
    global_email=$(git config --global user.email 2>/dev/null || echo "(not set)")

    local is_repo
    is_repo=$(git rev-parse --is-inside-work-tree 2>/dev/null || echo "false")
    local local_name=""
    local local_email=""
    if [[ "$is_repo" == "true" ]]; then
        local_name=$(git config --local user.name 2>/dev/null || true)
        local_email=$(git config --local user.email 2>/dev/null || true)
    fi

    echo ""
    echo "============================================================"
    echo " CURRENT GITHUB & GIT IDENTITY"
    echo "============================================================"
    echo -e " GitHub CLI Active : \033[0;32m$active_gh\033[0m"
    echo -e " Git Global Name   : \033[0;32m$global_name\033[0m"
    echo -e " Git Global Email  : \033[0;32m$global_email\033[0m"

    if [[ "$is_repo" == "true" && (-n "$local_name" || -n "$local_email") ]]; then
        echo " ------------------------------------------------------------"
        echo -e " \033[1;33m[Repo Local Override detected in current directory]\033[0m"
        echo -e " Git Local Name    : \033[1;33m$local_name\033[0m"
        echo -e " Git Local Email   : \033[1;33m$local_email\033[0m"
    fi
    echo "============================================================"
    echo ""
}

show_list() {
    local active_gh
    active_gh=$(gh api user --jq '.login' 2>/dev/null || echo "")

    echo ""
    echo -e "\033[1;33mConfigured Account Profiles:\033[0m"
    echo "================================================================================"

    if [[ -f "$CONFIG_FILE" ]] && command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, sys
active = sys.argv[1].lower()
try:
    with open('$CONFIG_FILE') as f:
        accounts = json.load(f)
    if not accounts:
        print('[INFO] No accounts configured yet. Run \"gswitch setup\" to add accounts.')
    for a in accounts:
        is_act = (a.get('username', '').lower() == active)
        marker = '> ' if is_act else '  '
        status = '* ACTIVE' if is_act else f\"(key: {a.get('key','')})\"
        color = '\033[0;32m' if is_act else ''
        reset = '\033[0m' if is_act else ''
        print(f\"{color}{marker}[{a.get('index')}] {a.get('label',''):<18} {a.get('username',''):<18} {a.get('email',''):<40} {status}{reset}\")
except Exception:
    print('[INFO] No accounts configured yet.')
" "$active_gh"
    elif [[ -f "$CONFIG_FILE" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '.[] | "   [\(.index)] \(.label) (\(.username)) - \(.email)"' "$CONFIG_FILE"
    else
        echo "No accounts configuration found at $CONFIG_FILE. Run 'gswitch setup'."
    fi
    echo "================================================================================"
    echo ""
}

sync_from_gh() {
    echo ""
    echo -e "\033[0;36mScanning GitHub CLI for authenticated accounts...\033[0m"
    
    local accounts=()
    while IFS= read -r line; do
        if [[ $line =~ Logged\ in\ to.*\ account\ ([a-zA-Z0-9_-]+) ]]; then
            accounts+=("${BASH_REMATCH[1]}")
        fi
    done < <(gh auth status 2>&1 || true)

    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo -e "\033[1;33m[WARNING] No accounts found in 'gh auth status'. Please login via 'gh auth login'.\033[0m"
        return 1
    fi

    echo -e "\033[0;32mFound ${#accounts[@]} account(s): ${accounts[*]}\033[0m"
    mkdir -p "$CONFIG_DIR"

    python3 -c "
import json, sys, subprocess

accounts = sys.argv[1:]
orig_user = ''
try:
    orig_user = subprocess.check_output(['gh', 'api', 'user', '--jq', '.login'], stderr=subprocess.DEVNULL).decode().strip()
except Exception:
    pass

result = []
for idx, user in enumerate(accounts, 1):
    try:
        subprocess.call(['gh', 'auth', 'switch', '-u', user], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        out = subprocess.check_output(['gh', 'api', 'user'], stderr=subprocess.DEVNULL)
        info = json.loads(out)
        uid = info.get('id', 0)
        uname = info.get('name') or user
    except Exception:
        uid = 0
        uname = user

    result.append({
        'index': idx,
        'key': user.lower(),
        'aliases': [str(idx), user.lower()],
        'label': user,
        'username': user,
        'name': uname,
        'email': f'{uid}+{user}@users.noreply.github.com',
        'description': f'GitHub account {user}'
    })

if orig_user:
    subprocess.call(['gh', 'auth', 'switch', '-u', orig_user], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

with open('$CONFIG_FILE', 'w') as f:
    json.dump(result, f, indent=2)
print(f'[OK] Successfully synced {len(result)} accounts to $CONFIG_FILE!')
" "${accounts[@]}"
    show_list
}

add_account() {
    local passed_user="$1"
    local passed_key="$2"
    local passed_name="$3"
    local passed_email="$4"

    echo ""
    echo -e "\033[0;36m=== Add New GitHub Account Profile ===\033[0m"

    local username="$passed_user"
    if [[ -z "$username" ]]; then
        read -r -p "Enter GitHub Username: " username
    fi
    if [[ -z "$username" ]]; then
        echo "Cancelled: username cannot be empty."
        return
    fi

    local uid="0"
    local uname="$username"
    if command -v gh >/dev/null 2>&1; then
        out=$(gh api "users/$username" 2>/dev/null || true)
        if [[ -n "$out" ]]; then
            uid=$(python3 -c "import json, sys; print(json.loads(sys.argv[1]).get('id', 0))" "$out" 2>/dev/null || echo "0")
            uname=$(python3 -c "import json, sys; print(json.loads(sys.argv[1]).get('name') or sys.argv[2])" "$out" "$username" 2>/dev/null || echo "$username")
        fi
    fi

    local key="$passed_key"
    if [[ -z "$key" ]]; then
        if [[ -n "$passed_user" ]]; then
            key="${username,,}"
        else
            read -r -p "Enter role/key (e.g. work, personal, school) [default: ${username,,}]: " key
            key=${key:-${username,,}}
        fi
    fi

    local label=""
    if [[ -n "$passed_user" && -n "$passed_key" ]]; then
        label="${key^}"
    else
        read -r -p "Enter display label [default: $username]: " label
        label=${label:-$username}
    fi

    local commit_name="$passed_name"
    if [[ -z "$commit_name" ]]; then
        if [[ -n "$passed_user" && -n "$passed_key" ]]; then
            commit_name="$uname"
        else
            read -r -p "Enter commit author name [default: $uname]: " commit_name
            commit_name=${commit_name:-$uname}
        fi
    fi

    local def_email
    if [[ "$uid" != "0" ]]; then
        def_email="${uid}+${username}@users.noreply.github.com"
    else
        def_email="${username}@users.noreply.github.com"
    fi

    local commit_email="$passed_email"
    if [[ -z "$commit_email" ]]; then
        if [[ -n "$passed_user" && -n "$passed_key" ]]; then
            commit_email="$def_email"
        else
            read -r -p "Enter commit email [default: $def_email]: " commit_email
            commit_email=${commit_email:-$def_email}
        fi
    fi

    mkdir -p "$CONFIG_DIR"
    python3 -c "
import json, os, sys
cfg = '$CONFIG_FILE'
data = []
if os.path.exists(cfg):
    try:
        with open(cfg) as f: data = json.load(f)
    except: pass

u = sys.argv[1]
k = sys.argv[2].lower()
lbl = sys.argv[3]
cn = sys.argv[4]
ce = sys.argv[5]

# Remove existing if same key or username to prevent duplicates
data = [a for a in data if a.get('key','').lower() != k and a.get('username','').lower() != u.lower()]

idx = len(data) + 1
data.append({
    'index': idx,
    'key': k,
    'aliases': [str(idx), k, u.lower()],
    'label': lbl,
    'username': u,
    'name': cn,
    'email': ce,
    'description': f'{lbl} account ({u})'
})
with open(cfg, 'w') as f: json.dump(data, f, indent=2)
print(f'[OK] Account \'{lbl}\' ({u}) successfully configured!')
" "$username" "$key" "$label" "$commit_name" "$commit_email"

    show_list
}

remove_account() {
    local target="$1"
    local force="$2"

    if [[ -z "$target" ]]; then
        show_list
        read -r -p "Enter account number, key, or username to remove (or Enter to cancel): " target
    fi
    if [[ -z "$target" ]]; then
        echo "Cancelled."
        return
    fi

    python3 -c "
import json, sys
cfg = '$CONFIG_FILE'
try:
    with open(cfg) as f: data = json.load(f)
except Exception:
    print('[ERROR] Config file not found.')
    sys.exit(1)

q = sys.argv[1].lower()
force = (sys.argv[2].lower() in ['true', '1', 'yes'])
match = None
for a in data:
    aliases = [str(x).lower() for x in a.get('aliases', [])]
    if str(a.get('index')) == q or a.get('key','').lower() == q or a.get('username','').lower() == q or q in aliases:
        match = a
        break

if not match:
    print(f'[ERROR] Account \"{q}\" not found. Run \"gswitch list\" to view accounts.')
    sys.exit(1)

proceed = force
if not proceed:
    conf = input(f\"Are you sure you want to remove '{match['label']}' ({match['username']})? [y/N]: \")
    proceed = (conf.strip().lower() == 'y')

if proceed:
    data = [a for a in data if a != match]
    for idx, a in enumerate(data, 1): a['index'] = idx
    with open(cfg, 'w') as f: json.dump(data, f, indent=2)
    print(f\"\n[OK] Account '{match['label']}' ({match['username']}) removed successfully.\")
else:
    print('Cancelled.')
" "$target" "$force"
    show_list
}

show_help() {
    echo ""
    echo "============================================================"
    echo -e " \033[0;36mgit-account-switcher (gswitch) ⚡\033[0m"
    echo -e " \033[0;34mFast Multi-Account GitHub & Git Identity Switcher\033[0m"
    echo "============================================================"
    echo ""
    echo -e "\033[1;33mUSAGE:\033[0m"
    echo "  gswitch [account]                   Switch account globally (by key, username, or index)"
    echo "  gswitch -l [account]                Switch account locally (current repository only)"
    echo "  gswitch                             Open interactive account selection menu"
    echo "  gswitch status | who                View active GitHub token & Git identities"
    echo "  gswitch list | ls                   List all configured account profiles"
    echo "  gswitch sync                        Auto-discover & sync accounts from GitHub CLI"
    echo "  gswitch setup                       Launch interactive first-time setup wizard"
    echo "  gswitch add [user] [key] [name] [email]  Add or update an account profile"
    echo "  gswitch remove [key] [-f]           Remove an account profile and re-index list"
    echo "  gswitch help                        Display this help message"
    echo ""
    echo -e "\033[1;33mCOMMANDS:\033[0m"
    echo "  add      Add a new profile interactively or via args: gswitch add <user> <key> [name] [email]"
    echo "  remove   Remove a profile by key, user, or index: gswitch remove <key> [-f]"
    echo "  sync     Scan 'gh auth status', fetch IDs, and configure private noreply emails"
    echo "  setup    Launch the first-time guided setup wizard"
    echo "  status   Display active GitHub CLI user and global/local Git user.name & email"
    echo "  list     Display formatted table of all configured profiles with * ACTIVE badge"
    echo ""
    echo -e "\033[1;33mFLAGS:\033[0m"
    echo "  -l, --local                         Scope changes to current repository only (.git/config)"
    echo "  -g, --global                        Scope changes system-wide (default)"
    echo "  -f, --force                         Force action without interactive confirmation"
    echo "  -h, --help                          Show detailed help information"
    echo ""
    echo -e "\033[1;33mEXAMPLES:\033[0m"
    echo "  gswitch personal                    # Switch to 'personal' profile globally"
    echo "  gswitch work                        # Switch to 'work' profile globally"
    echo "  gswitch 1                           # Switch to profile #1"
    echo "  gswitch -l work                     # Apply 'work' author to THIS repository only"
    echo "  gswitch sync                        # Auto-import all accounts from 'gh auth status'"
    echo "  gswitch add                         # Add a new account interactively"
    echo "  gswitch add octocat work            # Add 'octocat' with key 'work' non-interactively"
    echo "  gswitch remove work                 # Remove the 'work' account profile"
    echo "  gswitch remove 2 -f                 # Force remove account #2 without confirmation"
    echo "  git who                             # Fast alias to inspect current identity"
    echo ""
    echo -e "\033[1;33mCONFIG PATH:\033[0m"
    echo -e "  \033[0;36m$CONFIG_FILE\033[0m"
    echo ""
}

setup_wizard() {
    echo ""
    echo "============================================================"
    echo " git-account-switcher Setup Wizard"
    echo "============================================================"
    if gh auth status 2>&1 | grep -q 'Logged in to .* account'; then
        read -r -p "Found logged-in accounts in GitHub CLI. Auto-import them now? [Y/n]: " AUTO
        if [[ -z "$AUTO" || "$AUTO" =~ ^[yY]$ ]]; then
            sync_from_gh
            return
        fi
    fi

    while true; do
        add_account
        read -r -p "Add another account? [y/N]: " MORE
        if [[ "$MORE" != [yY]* ]]; then
            break
        fi
    done
}

switch_account() {
    local label="$1"
    local username="$2"
    local name="$3"
    local email="$4"
    local is_local="$5"

    echo ""
    echo -e "\033[1;33m>> Switching to account: [$label] ($username)...\033[0m"

    if ! gh auth switch -u "$username"; then
        echo -e "\033[0;31m[ERROR] Failed to switch GitHub CLI to $username\033[0m"
        exit 1
    fi

    if [[ "$is_local" == "true" ]]; then
        if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) != "true" ]]; then
            echo -e "\033[0;31m[ERROR] Current directory is not a Git repository.\033[0m"
            exit 1
        fi
        git config --local user.name "$name"
        git config --local user.email "$email"
        echo -e "\033[0;32m[OK] GitHub CLI switched to : $username\033[0m"
        echo -e "\033[0;32m[OK] Git user.name (LOCAL)  : $name\033[0m"
        echo -e "\033[0;32m[OK] Git user.email (LOCAL) : $email\033[0m"
        echo ""
        echo -e "\033[0;36m=> Applied locally to this repository only!\033[0m"
    else
        git config --global user.name "$name"
        git config --global user.email "$email"
        echo -e "\033[0;32m[OK] GitHub CLI switched to : $username\033[0m"
        echo -e "\033[0;32m[OK] Git user.name (GLOBAL) : $name\033[0m"
        echo -e "\033[0;32m[OK] Git user.email (GLOBAL): $email\033[0m"
        echo ""
        echo -e "\033[0;36m=> Ready to commit & push as $label!\033[0m"
    fi
    echo ""
}

# Process flags
APPLY_LOCAL="false"
TARGET=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -l|--local)
            APPLY_LOCAL="true"
            shift
            ;;
        -g|--global)
            APPLY_LOCAL="false"
            shift
            ;;
        status|who|current|-s)
            show_status
            exit 0
            ;;
        list|ls)
            show_list
            exit 0
            ;;
        sync|import)
            sync_from_gh
            exit 0
            ;;
        setup|init)
            setup_wizard
            exit 0
            ;;
        add)
            shift
            add_account "$@"
            exit 0
            ;;
        remove|rm|delete)
            shift
            FORCE="false"
            TARGET=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -f|--force|-y|--yes) FORCE="true" ;;
                    *) TARGET="$1" ;;
                esac
                shift
            done
            remove_account "$TARGET" "$FORCE"
            exit 0
            ;;
        help|-h|--help)
            show_help
            exit 0
            ;;
        *)
            TARGET="$1"
            shift
            ;;
    esac
done

# If no config exists, prompt setup
if [[ ! -f "$CONFIG_FILE" ]]; then
    read -r -p "No accounts configured yet. Run setup wizard now? [Y/n]: " RUN_WIZ
    if [[ -z "$RUN_WIZ" || "$RUN_WIZ" =~ ^[yY]$ ]]; then
        setup_wizard
        exit 0
    else
        exit 0
    fi
fi

if [[ -z "$TARGET" ]]; then
    show_status
    show_list
    read -r -p "Select account, 's' to sync, 'a' to add, or Enter to cancel: " CHOICE
    if [[ "$CHOICE" =~ ^[sS]$ ]]; then
        sync_from_gh
        exit 0
    elif [[ "$CHOICE" =~ ^[aA]$ ]]; then
        add_account
        exit 0
    elif [[ -n "$CHOICE" ]]; then
        TARGET="$CHOICE"
    else
        echo "Cancelled."
        exit 0
    fi
fi

# Find account in JSON with exact and fuzzy matching
SELECTED=$(python3 -c "
import json, sys
q = sys.argv[1].lower()
with open('$CONFIG_FILE') as f:
    data = json.load(f)

# 1. Exact match
for a in data:
    aliases = [str(x).lower() for x in a.get('aliases', [])]
    if str(a.get('index')) == q or a.get('key','').lower() == q or a.get('username','').lower() == q or q in aliases:
        print(f\"{a.get('label')}\t{a.get('username')}\t{a.get('name')}\t{a.get('email')}\")
        sys.exit(0)

# 2. Fuzzy match
for a in data:
    u = a.get('username','').lower()
    k = a.get('key','').lower()
    if q in u or u in q or q in k or k in q:
        print(f\"{a.get('label')}\t{a.get('username')}\t{a.get('name')}\t{a.get('email')}\")
        sys.exit(0)
" "$TARGET" 2>/dev/null || true)

if [[ -n "$SELECTED" ]]; then
    IFS=$'\t' read -r S_LABEL S_USER S_NAME S_EMAIL <<< "$SELECTED"
    switch_account "$S_LABEL" "$S_USER" "$S_NAME" "$S_EMAIL" "$APPLY_LOCAL"
else
    echo -e "\033[0;31m[ERROR] Account '$TARGET' not found. Run 'gswitch list', 'gswitch add', or 'gswitch sync'.\033[0m"
    exit 1
fi
