#!/usr/bin/env bash
# ==============================================================================
# git-account-switcher (gswitch) - Fast Multi-Account GitHub & Git Switcher
# Native POSIX Bash for macOS, Linux, and Windows (Git Bash/WSL)
# ==============================================================================

to_lower() {
    printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'
}

capitalize() {
    printf '%s' "$1" | awk '{ print toupper(substr($0,1,1)) substr($0,2) }'
}

if [[ "$1" == "cred" ]]; then
    target_user="$2"
    action="$3"
    cred_host="$4"
    cred_host_lc=$(to_lower "$cred_host")
    if [[ -n "$cred_host" && "$cred_host_lc" != "github.com" && "$cred_host_lc" != "gist.github.com" ]]; then
        exit 0
    fi
    if [[ -z "$cred_host" && ! -t 0 ]]; then
        while IFS= read -r -t 1 line; do
            [[ $line =~ ^host=(.+)$ ]] && cred_host="${BASH_REMATCH[1]}"
            if [[ -z "$target_user" && $line =~ ^username=(.+)$ ]]; then
                target_user="${BASH_REMATCH[1]}"
            fi
        done
    fi
    cred_host_lc=$(to_lower "$cred_host")
    if [[ -n "$cred_host" && "$cred_host_lc" != "github.com" && "$cred_host_lc" != "gist.github.com" ]]; then
        exit 0
    fi
    if [[ -n "$target_user" && ! "$target_user" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        exit 0
    fi
    if [[ "$action" == "get" || -z "$action" ]]; then
        if [[ -n "$target_user" ]]; then
            token=$(gh auth token -u "$target_user" 2>/dev/null || true)
            if [[ -n "$token" ]]; then
                echo "username=$target_user"
                echo "password=$token"
            fi
        fi
    fi
    exit 0
fi

# If running in Windows Git Bash and powershell.exe is available, delegate to powershell
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]] && command -v powershell.exe >/dev/null 2>&1; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && (pwd -W 2>/dev/null || pwd))"
    exec powershell.exe -NoProfile -InputFormat None -ExecutionPolicy Bypass -File "$SCRIPT_DIR/git-account-switcher.ps1" "$@"
fi

SCRIPT_VERSION="1.0.0"
RELEASES_REPO="ThanhNguyxnOrg/git-account-switcher"
RELEASE_WORKFLOW="ThanhNguyxnOrg/git-account-switcher/.github/workflows/release.yml"
GSWITCH_HOME="${GIT_ACCOUNT_SWITCHER_HOME:-$HOME}"
PYTHON_BIN="${GIT_ACCOUNT_SWITCHER_PYTHON:-python3}"
CONFIG_FILE="${GIT_ACCOUNT_SWITCHER_CONFIG:-$GSWITCH_HOME/.config/git-account-switcher/accounts.json}"
CONFIG_DIR="$(dirname "$CONFIG_FILE")"
export GIT_ACCOUNT_SWITCHER_CONFIG="$CONFIG_FILE"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF_SCRIPT="$SELF_DIR/git-account-switcher"
if [[ ! -f "$SELF_SCRIPT" ]]; then
    SELF_SCRIPT="$(command -v git-account-switcher 2>/dev/null || printf '%s' "$SELF_SCRIPT")"
fi

require_python() {
    if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
        echo -e "\033[0;31m[ERROR] Python 3 is required for this command.\033[0m" >&2
        echo "        Install Python 3 and ensure '$PYTHON_BIN' is in PATH." >&2
        return 1
    fi
}

sh_single_quote() {
    "$PYTHON_BIN" -c 'import shlex,sys; print(shlex.quote(sys.argv[1]))' "$1" 2>/dev/null || printf "'%s'" "$1"
}

cred_helper_command() {
    local user="$1"
    printf '!%s cred %s get github.com' "$(sh_single_quote "$SELF_SCRIPT")" "$(sh_single_quote "$user")"
}

get_active_gh_user() {
    local u
    u=$(gh auth status --active 2>&1 | grep -oE 'Logged in to .* account [a-zA-Z0-9_-]+' | awk '{print $NF}' || true)
    if [[ -z "$u" ]]; then
        u=$(gh api user --jq '.login' 2>/dev/null || echo "(none / not logged in)")
    fi
    echo "$u"
}

show_status() {
    local active_gh
    active_gh=$(get_active_gh_user)
    local global_name
    global_name=$(git config --global user.name 2>/dev/null || echo "(not set)")
    local global_email
    global_email=$(git config --global user.email 2>/dev/null || echo "(not set)")

    local is_repo
    is_repo=$(git rev-parse --is-inside-work-tree 2>/dev/null || echo "false")
    local local_name=""
    local local_email=""
    if [[ "$is_repo" == "true" ]]; then
        local_name=$(git config --local user.name 2>/dev/null || true)
        local_email=$(git config --local user.email 2>/dev/null || true)
    fi

    echo ""
    echo "============================================================"
    echo " CURRENT GITHUB & GIT IDENTITY"
    echo "============================================================"
    echo -e " GitHub CLI Active : \033[0;32m$active_gh\033[0m"
    echo -e " Git Global Name   : \033[0;32m$global_name\033[0m"
    echo -e " Git Global Email  : \033[0;32m$global_email\033[0m"

    local eff_name eff_email eff_sign
    eff_name=$(git config user.name 2>/dev/null || echo "")
    eff_email=$(git config user.email 2>/dev/null || echo "")
    eff_sign=$(git config user.signingkey 2>/dev/null || echo "")

    if [[ -n "$eff_sign" ]]; then
        echo -e " Git Signing Key   : \033[0;32m$eff_sign\033[0m"
    fi

    # Check if current directory matches any configured folder binding
    local curr_path matched_dir matched_cfg
    if command -v cygpath >/dev/null 2>&1; then
        curr_path=$(cygpath -m "$(pwd)")
    elif (pwd -W) >/dev/null 2>&1; then
        curr_path=$(pwd -W)
    else
        curr_path=$(pwd)
    fi
    curr_path="${curr_path%/}/"

    while IFS= read -r line; do
        if [[ $line =~ includeif\.gitdir(/i)?:(.*)\.path=(.*) ]]; then
            local b_dir="${BASH_REMATCH[2]}"
            local b_cfg="${BASH_REMATCH[3]}"
            local clean_b="${b_dir%/}/"
            local curr_path_lc clean_b_lc
            curr_path_lc=$(to_lower "$curr_path")
            clean_b_lc=$(to_lower "$clean_b")
            if [[ "$curr_path_lc" == "$clean_b_lc"* ]]; then
                matched_dir="$b_dir"
                matched_cfg="$b_cfg"
                break
            fi
        fi
    done < <(git config --global --list --show-origin 2>/dev/null | grep -E 'includeif\.gitdir' || true)

    if [[ "$is_repo" == "true" && (-n "$local_name" || -n "$local_email") ]]; then
        echo " ------------------------------------------------------------"
        echo -e " \033[1;33m[Repo Local Override detected in current directory]\033[0m"
        echo -e " Git Local Name    : \033[1;33m$local_name\033[0m"
        echo -e " Git Local Email   : \033[1;33m$local_email\033[0m"
        if [[ -n "$matched_dir" ]]; then
            echo -e " \033[1;31m[WARNING] Folder Binding active ($matched_dir) is SHADOWED by this local override!\033[0m"
            echo -e "           \033[0;33mTo inherit folder account, run: git config --local --unset-all user.name && git config --local --unset-all user.email\033[0m"
        fi
    elif [[ -n "$matched_dir" ]]; then
        echo " ------------------------------------------------------------"
        echo -e " \033[1;33m[Folder includeIf Binding Active in this directory]\033[0m"
        echo -e " Bound Folder      : \033[0;36m$matched_dir\033[0m"
        echo -e " Git Effective Name : \033[0;32m$eff_name\033[0m"
        echo -e " Git Effective Email: \033[0;32m$eff_email\033[0m"
        local b_user
        b_user=$(git config -f "$matched_cfg" credential.https://github.com.username 2>/dev/null || true)
        local active_gh_lc b_user_lc
        active_gh_lc=$(to_lower "$active_gh")
        b_user_lc=$(to_lower "$b_user")
        if [[ -n "$b_user" && "$active_gh" != "(none / not logged in)" && "$active_gh_lc" != "$b_user_lc" ]]; then
            echo -e " \033[1;33m[INFO] GitHub CLI is active as '$active_gh', while this folder commits/pushes as '$b_user'.\033[0m"
            echo -e "        \033[0;90mTo switch GitHub CLI commands (gh pr, gh issue) to '$b_user', run: gswitch $b_user\033[0m"
        fi
    elif [[ -n "$eff_email" && ("$eff_email" != "$global_email" || "$eff_name" != "$global_name") ]]; then
        echo " ------------------------------------------------------------"
        echo -e " \033[1;33m[Effective identity differs from global settings]\033[0m"
        echo -e " Git Effective Name : \033[1;33m$eff_name\033[0m"
        echo -e " Git Effective Email: \033[1;33m$eff_email\033[0m"
    fi

    if [[ "$is_repo" == "true" ]]; then
        local remote_url
        remote_url=$(git config --get remote.origin.url 2>/dev/null || echo "")
        if [[ -n "$remote_url" ]]; then
            echo " ------------------------------------------------------------"
            echo -e " Remote Origin     : \033[0;90m$remote_url\033[0m"
            case "$remote_url" in
                git@github.com:*|ssh://*)
                    echo -e " \033[1;33m[WARNING] Remote uses SSH ($remote_url).\033[0m"
                    echo -e "           \033[0;33mGit credential helper applies to HTTPS URLs.\033[0m"
                    echo -e "           \033[0;33mTo isolate push tokens with gswitch, switch remote to HTTPS:\033[0m"
                    echo -e "           \033[0;33mgit remote set-url origin https://github.com/<org>/<repo>.git\033[0m"
                    ;;
            esac
        fi
    fi
    echo "============================================================"
    echo ""
}

show_list() {
    local active_gh
    active_gh=$(get_active_gh_user)

    echo ""
    echo -e "\033[1;33mConfigured Account Profiles:\033[0m"
    echo "================================================================================"

    if [[ -f "$CONFIG_FILE" ]] && command -v "$PYTHON_BIN" >/dev/null 2>&1; then
        "$PYTHON_BIN" -c "
import json, os, sys
active = sys.argv[1].lower()
try:
    with open(os.environ['GIT_ACCOUNT_SWITCHER_CONFIG'], encoding='utf-8-sig') as f:
        accounts = json.load(f)
    if not accounts:
        print('[INFO] No accounts configured yet. Run \"gswitch setup\" to add accounts.')
    for a in accounts:
        is_act = (a.get('username', '').lower() == active)
        marker = '> ' if is_act else '  '
        status = '* ACTIVE' if is_act else ''
        color = '\033[0;32m' if is_act else ''
        reset = '\033[0m' if is_act else ''
        aliases = ', '.join([str(x) for x in a.get('aliases', [])])
        print(f\"{color}{marker}[{a.get('index')}] {a.get('label',''):<16} {a.get('username',''):<16} {a.get('email',''):<38} {status}{reset}\")
        alias_color = '\033[0;32m' if is_act else '\033[0;36m'
        print(f\"       {alias_color}Aliases: {aliases}{reset}\")
except Exception:
    print('[INFO] No accounts configured yet.')
" "$active_gh"
    elif [[ -f "$CONFIG_FILE" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '.[] | "   [\(.index)] \(.label) (\(.username)) - \(.email) - Aliases: \(.aliases | join(", "))"' "$CONFIG_FILE"
    else
        if [[ -f "$CONFIG_FILE" ]]; then
            echo -e "\033[0;31m[ERROR] Python 3 (or jq) is required to read $CONFIG_FILE.\033[0m" >&2
        else
            echo "No accounts configuration found at $CONFIG_FILE. Run 'gswitch setup'."
        fi
    fi
    echo "================================================================================"
    echo ""
}

sync_from_gh() {
    require_python || return 1
    echo ""
    echo -e "\033[0;36mScanning GitHub CLI for authenticated accounts...\033[0m"
    
    local accounts=()
    while IFS= read -r line; do
        if [[ $line =~ Logged\ in\ to.*\ account\ ([a-zA-Z0-9_-]+) ]]; then
            accounts+=("${BASH_REMATCH[1]}")
        fi
    done < <(gh auth status 2>&1 || true)

    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo -e "\033[1;33m[WARNING] No accounts found in 'gh auth status'. Please login via 'gh auth login'.\033[0m"
        return 1
    fi

    echo -e "\033[0;32mFound ${#accounts[@]} account(s): ${accounts[*]}\033[0m"
    mkdir -p "$CONFIG_DIR"

    "$PYTHON_BIN" -c "
import json, os, sys, subprocess

cfg = os.environ['GIT_ACCOUNT_SWITCHER_CONFIG']
accounts = sys.argv[1:]
existing = []
if os.path.exists(cfg):
    try:
        with open(os.environ['GIT_ACCOUNT_SWITCHER_CONFIG'], encoding='utf-8-sig') as f:
            existing = json.load(f)
    except Exception:
        pass

result = list(existing)
detected = []
for user in accounts:
    if user.lower() not in [x.lower() for x in detected]:
        detected.append(user)

for user in detected:
    matched = None
    for ex in result:
        if ex.get('username', '').lower() == user.lower():
            matched = ex
            break
    if matched:
        continue
    uid = 0
    uname = user
    try:
        out = subprocess.check_output(['gh', 'api', f'users/{user}'], stderr=subprocess.DEVNULL)
        info = json.loads(out)
        uid = info.get('id', 0)
        uname = info.get('name') or user
    except Exception:
        pass
    email = f'{uid}+{user}@users.noreply.github.com' if uid else f'{user}@users.noreply.github.com'
    result.append({
        'key': user.lower(),
        'label': user,
        'username': user,
        'name': uname,
        'email': email,
        'description': f'GitHub account {user}'
    })

for idx, a in enumerate(result, 1):
    a['index'] = idx
    aliases = [str(x) for x in a.get('aliases', []) if not str(x).isdigit()]
    for required in (a.get('key', ''), a.get('username', '')):
        if required and required.lower() not in aliases:
            aliases.append(required.lower())
    a['aliases'] = [str(idx)] + aliases

tmp = cfg + '.tmp'
with open(tmp, 'w', encoding='utf-8') as f:
    json.dump(result, f, indent=2)
os.replace(tmp, cfg)
print(f'[OK] Synced {len(detected)} authenticated account(s); {len(result)} profile(s) preserved in {cfg}.')
" "${accounts[@]}"
    show_list
}

add_account() {
    require_python || return 1
    local passed_user="$1"
    local passed_key="$2"
    local passed_name="$3"
    local passed_email="$4"

    echo ""
    echo -e "\033[0;36m=== Add New GitHub Account Profile ===\033[0m"

    local username="$passed_user"
    if [[ -z "$username" ]]; then
        read -r -p "Enter GitHub Username: " username
    fi
    if [[ -z "$username" ]]; then
        echo "Cancelled: username cannot be empty."
        return
    fi
    if [[ ! "$username" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo -e "\033[0;31m[ERROR] Invalid GitHub username: use letters, digits, dot, underscore, or hyphen.\033[0m"
        return 1
    fi

    local uid="0"
    local uname="$username"
    if command -v gh >/dev/null 2>&1; then
        out=$(gh api "users/$username" 2>/dev/null || true)
        if [[ -n "$out" ]]; then
            uid=$("$PYTHON_BIN" -c "import json, sys; print(json.loads(sys.argv[1]).get('id', 0))" "$out" 2>/dev/null || echo "0")
            uname=$("$PYTHON_BIN" -c "import json, sys; print(json.loads(sys.argv[1]).get('name') or sys.argv[2])" "$out" "$username" 2>/dev/null || echo "$username")
        fi
    fi

    local username_lc
    username_lc=$(to_lower "$username")
    local key="$passed_key"
    if [[ -z "$key" ]]; then
        if [[ -n "$passed_user" ]]; then
            key="$username_lc"
        else
            read -r -p "Enter role/key (e.g. work, personal, school) [default: $username_lc]: " key
            key=${key:-$username_lc}
        fi
    fi
    key=$(to_lower "$key")
    if [[ ! "$key" =~ ^[a-z0-9._-]+$ ]]; then
        echo -e "\033[0;31m[ERROR] Invalid key '$key'. Use lowercase letters, digits, dot, underscore, or hyphen.\033[0m"
        return 1
    fi

    local label=""
    if [[ -n "$passed_user" && -n "$passed_key" ]]; then
        label="$(capitalize "$key")"
    else
        read -r -p "Enter display label [default: $username]: " label
        label=${label:-$username}
    fi

    local commit_name="$passed_name"
    if [[ -z "$commit_name" ]]; then
        if [[ -n "$passed_user" && -n "$passed_key" ]]; then
            commit_name="$uname"
        else
            read -r -p "Enter commit author name [default: $uname]: " commit_name
            commit_name=${commit_name:-$uname}
        fi
    fi

    local def_email
    if [[ "$uid" != "0" ]]; then
        def_email="${uid}+${username}@users.noreply.github.com"
    else
        def_email="${username}@users.noreply.github.com"
    fi

    local commit_email="$passed_email"
    if [[ -z "$commit_email" ]]; then
        if [[ -n "$passed_user" && -n "$passed_key" ]]; then
            commit_email="$def_email"
        else
            read -r -p "Enter commit email [default: $def_email]: " commit_email
            commit_email=${commit_email:-$def_email}
        fi
    fi

    if [[ "$commit_name" == *$'\n'* || "$commit_name" == *$'\r'* ]]; then
        echo -e "\033[0;31m[ERROR] Commit author name cannot contain newlines.\033[0m"
        return 1
    fi
    if [[ "$commit_email" == *$'\n'* || "$commit_email" == *$'\r'* ]]; then
        echo -e "\033[0;31m[ERROR] Commit email cannot contain newlines.\033[0m"
        return 1
    fi

    local custom_aliases=""
    if [[ -z "$passed_user" || -z "$passed_key" ]]; then
        read -r -p "Enter additional shortcut aliases (comma-separated, e.g. 'work, w, corp') [optional]: " custom_aliases
    fi

    mkdir -p "$CONFIG_DIR"
    "$PYTHON_BIN" -c "
import json, os, sys
cfg = os.environ['GIT_ACCOUNT_SWITCHER_CONFIG']
data = []
if os.path.exists(cfg):
    try:
        with open(cfg, encoding='utf-8-sig') as f: data = json.load(f)
    except Exception: pass

u = sys.argv[1]
k = sys.argv[2].lower()
lbl = sys.argv[3]
cn = sys.argv[4]
ce = sys.argv[5]
extra_al = sys.argv[6] if len(sys.argv) > 6 else ''

match = None
for a in data:
    if a.get('key','').lower() == k or a.get('username','').lower() == u.lower():
        match = a
        break

if match:
    match.update({'key': k, 'label': lbl, 'username': u, 'name': cn, 'email': ce})
    if not match.get('description'):
        match['description'] = f'{lbl} account ({u})'
    aliases = [str(x) for x in match.get('aliases', []) if not str(x).isdigit()]
else:
    match = {
        'key': k,
        'label': lbl,
        'username': u,
        'name': cn,
        'email': ce,
        'description': f'{lbl} account ({u})'
    }
    aliases = []
    data.append(match)

for required in (k, u.lower()):
    if required and required not in aliases:
        aliases.append(required)
if extra_al:
    for part in extra_al.replace(',', ' ').split():
        p = part.strip().lower()
        if p and p not in aliases:
            aliases.append(p)

match['aliases'] = aliases
for idx, a in enumerate(data, 1):
    a['index'] = idx
    rest = [str(x) for x in a.get('aliases', []) if not str(x).isdigit()]
    a['aliases'] = [str(idx)] + [x for x in rest if x != str(idx)]

tmp = cfg + '.tmp'
with open(tmp, 'w', encoding='utf-8') as f: json.dump(data, f, indent=2)
os.replace(tmp, cfg)
print(f'[OK] Account \'{lbl}\' ({u}) successfully configured!')
" "$username" "$key" "$label" "$commit_name" "$commit_email" "$custom_aliases"

    show_list
}

remove_account() {
    require_python || return 1
    local target="$1"
    local force="$2"

    if [[ -z "$target" ]]; then
        show_list
        read -r -p "Enter account number, key, username, or alias to remove (or Enter to cancel): " target
    fi
    if [[ -z "$target" ]]; then
        echo "Cancelled."
        return
    fi

    "$PYTHON_BIN" -c "
import json, os, re, sys, subprocess
cfg = os.environ['GIT_ACCOUNT_SWITCHER_CONFIG']
try:
    with open(cfg, encoding='utf-8-sig') as f: data = json.load(f)
except Exception:
    print('[ERROR] Config file not found.')
    sys.exit(1)

q = sys.argv[1].lower()
force = (sys.argv[2].lower() in ['true', '1', 'yes'])
match = None
for a in data:
    aliases = [str(x).lower() for x in a.get('aliases', [])]
    if str(a.get('index')) == q or a.get('key','').lower() == q or a.get('username','').lower() == q or q in aliases:
        match = a
        break

if not match:
    print(f'[ERROR] Account \"{q}\" not found. Run \"gswitch list\" to view accounts.')
    sys.exit(1)

proceed = force
if not proceed:
    conf = input(f\"Are you sure you want to remove '{match['label']}' ({match['username']})? [y/N]: \")
    proceed = (conf.strip().lower() == 'y')

if proceed:
    key = match.get('key','')
    if not re.match(r'^[a-z0-9._-]+$', key):
        key = ''
    home = os.environ.get('GIT_ACCOUNT_SWITCHER_HOME', os.path.expanduser('~'))
    profile = os.path.join(home, '.gitconfig-' + key)
    def norm(p): return p.replace('\\\\', '/').lower()
    removed = 0
    try:
        keys = subprocess.run(['git','config','--global','--name-only','--get-regexp','^includeif\\\\.gitdir'], capture_output=True, text=True)
        for k in keys.stdout.splitlines():
            k = k.strip()
            if not k:
                continue
            val = subprocess.run(['git','config','--global','--get',k], capture_output=True, text=True).stdout.strip()
            if val and norm(val).endswith('/.gitconfig-' + key.lower()):
                subprocess.run(['git','config','--global','--unset-all',k], check=False, capture_output=True)
                removed += 1
    except Exception:
        pass
    if removed:
        remaining = subprocess.run(['git','config','--global','--get-regexp','^includeif\\\\.gitdir'], capture_output=True, text=True).stdout
        if norm(profile) not in norm(remaining) and os.path.exists(profile):
            try: os.remove(profile)
            except OSError: pass
        print(f'[INFO] Removed {removed} folder binding(s) for {key}.')
    data = [a for a in data if a != match]
    for idx, a in enumerate(data, 1):
        a['index'] = idx
        cleaned_aliases = [str(x) for x in a.get('aliases', []) if not str(x).isdigit()]
        cleaned_aliases.insert(0, str(idx))
        a['aliases'] = cleaned_aliases
    tmp = cfg + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f: json.dump(data, f, indent=2)
    os.replace(tmp, cfg)
    print(f\"\n[OK] Account '{match['label']}' ({match['username']}) removed successfully.\")
else:
    print('Cancelled.')
" "$target" "$force"
    show_list
}

alias_account() {
    require_python || return 1
    local target="$1"
    local new_alias="$2"

    if [[ -z "$target" ]]; then
        show_list
        read -r -p "Enter account number, key, or username to add alias to: " target
    fi
    if [[ -z "$target" ]]; then
        echo "Cancelled."
        return
    fi

    if [[ -z "$new_alias" ]]; then
        read -r -p "Enter new shortcut alias (e.g. 'w', 'corp', 'main'): " new_alias
    fi
    if [[ -z "$new_alias" ]]; then
        echo "Cancelled: alias cannot be empty."
        return
    fi
    new_alias=$(to_lower "$new_alias")
    if [[ ! "$new_alias" =~ ^[a-z0-9._-]+$ || "$new_alias" =~ ^[0-9]+$ ]]; then
        echo -e "\033[0;31m[ERROR] Invalid alias. Use letters, digits, dot, underscore, or hyphen; numeric aliases are reserved for indexes.\033[0m"
        return 1
    fi

    "$PYTHON_BIN" -c "
import json, os, sys
cfg = os.environ['GIT_ACCOUNT_SWITCHER_CONFIG']
try:
    with open(cfg, encoding='utf-8-sig') as f: data = json.load(f)
except Exception:
    print('[ERROR] Config file not found.')
    sys.exit(1)

q = sys.argv[1].lower()
na = sys.argv[2].lower().strip()

match = None
for a in data:
    aliases = [str(x).lower() for x in a.get('aliases', [])]
    if str(a.get('index')) == q or a.get('key','').lower() == q or a.get('username','').lower() == q or q in aliases:
        match = a
        break

if not match:
    print(f'[ERROR] Account \"{q}\" not found.')
    sys.exit(1)

cur_aliases = [str(x).lower() for x in match.get('aliases', [])]
if na in cur_aliases:
    print(f\"[INFO] Account '{match['label']}' already has alias '{na}'.\")
    sys.exit(0)

# Reassign if another account has it
for a in data:
    if a != match:
        other_al = [str(x).lower() for x in a.get('aliases', [])]
        if na in other_al or a.get('key','').lower() == na or a.get('username','').lower() == na:
            a['aliases'] = [x for x in a.get('aliases', []) if str(x).lower() != na]

match.setdefault('aliases', []).append(na)
tmp = cfg + '.tmp'
with open(tmp, 'w', encoding='utf-8') as f: json.dump(data, f, indent=2)
os.replace(tmp, cfg)
print(f\"\n[OK] Added alias '{na}' to account '{match['label']}' ({match['username']})!\")
print(f\"     All aliases: {', '.join(match['aliases'])}\n\")
" "$target" "$new_alias"
}

unalias_account() {
    require_python || return 1
    local target="$1"
    local alias_to_rm="$2"

    if [[ -z "$target" ]]; then
        show_list
        read -r -p "Enter account number, key, or username: " target
    fi
    if [[ -z "$target" ]]; then
        echo "Cancelled."
        return
    fi

    if [[ -z "$alias_to_rm" ]]; then
        read -r -p "Enter alias to remove: " alias_to_rm
    fi
    if [[ -z "$alias_to_rm" ]]; then
        echo "Cancelled."
        return
    fi

    "$PYTHON_BIN" -c "
import json, os, sys
cfg = os.environ['GIT_ACCOUNT_SWITCHER_CONFIG']
try:
    with open(cfg, encoding='utf-8-sig') as f: data = json.load(f)
except Exception:
    print('[ERROR] Config file not found.')
    sys.exit(1)

q = sys.argv[1].lower()
rm_a = sys.argv[2].lower().strip()

match = None
for a in data:
    aliases = [str(x).lower() for x in a.get('aliases', [])]
    if str(a.get('index')) == q or a.get('key','').lower() == q or a.get('username','').lower() == q or q in aliases:
        match = a
        break

if not match:
    print(f'[ERROR] Account \"{q}\" not found.')
    sys.exit(1)

cur_aliases = [str(x).lower() for x in match.get('aliases', [])]
if rm_a not in cur_aliases:
    print(f\"[WARNING] Alias '{rm_a}' was not found on '{match['label']}'.\")
    sys.exit(0)

match['aliases'] = [x for x in match.get('aliases', []) if str(x).lower() != rm_a]
tmp = cfg + '.tmp'
with open(tmp, 'w', encoding='utf-8') as f: json.dump(data, f, indent=2)
os.replace(tmp, cfg)
print(f\"\n[OK] Removed alias '{rm_a}' from account '{match['label']}'.\")
print(f\"     Remaining aliases: {', '.join(match['aliases'])}\n\")
" "$target" "$alias_to_rm"
}

edit_config() {
    mkdir -p "$CONFIG_DIR"
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "[]" > "$CONFIG_FILE"
    fi
    echo ""
    echo "Configuration file location:"
    echo -e "  \033[0;32m$CONFIG_FILE\033[0m"
    echo ""
    if command -v code >/dev/null 2>&1; then
        code "$CONFIG_FILE"
    elif [[ -n "$EDITOR" ]]; then
        "$EDITOR" "$CONFIG_FILE"
    elif command -v nano >/dev/null 2>&1; then
        nano "$CONFIG_FILE"
    elif command -v vim >/dev/null 2>&1; then
        vim "$CONFIG_FILE"
    else
        echo "Please edit the file with your preferred text editor."
    fi
}

bind_folder() {
    require_python || return 1
    local folder="$1"
    local target="$2"

    if [[ -z "$folder" ]]; then
        read -r -p "Enter folder path to bind (e.g. ~/work or /path/to/dir): " folder
    fi
    if [[ -z "$folder" ]]; then
        echo "Cancelled: folder cannot be empty."
        return
    fi

    local resolved
    if command -v cygpath >/dev/null 2>&1; then
        resolved=$(cd "$folder" 2>/dev/null && cygpath -m "$(pwd)" || cygpath -m "$folder")
    elif (cd "$folder" 2>/dev/null && pwd -W) >/dev/null 2>&1; then
        resolved=$(cd "$folder" 2>/dev/null && pwd -W || echo "$folder")
    else
        resolved=$(cd "$folder" 2>/dev/null && pwd || echo "$folder")
    fi
    local pattern="${resolved%/}/"

    if [[ -z "$target" ]]; then
        show_list
        read -r -p "Enter account to bind to this folder: " target
    fi
    if [[ -z "$target" ]]; then
        echo "Cancelled."
        return
    fi

    "$PYTHON_BIN" -c "
import json, sys, os, re, shlex, subprocess
cfg = os.environ['GIT_ACCOUNT_SWITCHER_CONFIG']
try:
    with open(cfg, encoding='utf-8-sig') as f: data = json.load(f)
except Exception:
    print('[ERROR] Config file not found.')
    sys.exit(1)

q = sys.argv[1].lower()
match = None
for a in data:
    aliases = [str(x).lower() for x in a.get('aliases', [])]
    if str(a.get('index')) == q or a.get('key','').lower() == q or a.get('username','').lower() == q or q in aliases:
        match = a
        break

if not match:
    print(f'[ERROR] Account \"{q}\" not found.')
    sys.exit(1)

key = match.get('key', '')
if not re.match(r'^[a-z0-9._-]+$', key):
    print('[ERROR] Account key contains unsafe characters; refusing to create a profile file.')
    sys.exit(1)

home = os.environ.get('GIT_ACCOUNT_SWITCHER_HOME', os.path.expanduser('~'))
prof_cfg = os.path.join(home, f'.gitconfig-{key}')
u = match['username']
if not re.match(r'^[A-Za-z0-9][A-Za-z0-9._-]*$', u):
    print('[ERROR] Account username contains unsafe characters; refusing to generate a credential helper.')
    sys.exit(1)
helper_cmd = '!' + shlex.quote(sys.argv[4]) + ' cred ' + shlex.quote(u) + ' get github.com'
skey = match.get('signingkey', '')

if os.path.exists(prof_cfg):
    try:
        with open(prof_cfg, encoding='utf-8-sig') as f: old = f.read()
    except Exception:
        old = ''
    if not re.search('git-account-switcher.*cred', old):
        os.replace(prof_cfg, prof_cfg + '.bak')
    else:
        os.remove(prof_cfg)

def cfg_set(*args):
    subprocess.run(['git', 'config', '-f', prof_cfg, *args], check=False, capture_output=True, text=True)

cfg_set('user.name', match['name'])
cfg_set('user.email', match['email'])
if skey:
    cfg_set('user.signingkey', skey)
    cfg_set('commit.gpgsign', 'true')
    if skey.startswith('ssh-') or skey.startswith('key::'):
        cfg_set('gpg.format', 'ssh')
for host in ('https://github.com', 'https://gist.github.com'):
    cfg_set('--add', f'credential.{host}.username', u)
    cfg_set('--add', f'credential.{host}.helper', '')
    cfg_set('--add', f'credential.{host}.helper', helper_cmd)

pat = sys.argv[2]
inc_key = f'includeIf.gitdir:{pat}.path'
norm_cfg = prof_cfg.replace('\\\\', '/')

def norm(p):
    return p.replace('\\\\', '/').lower()

removed_binding_files = []
def unset_matching_bindings():
    keys = subprocess.run(['git','config','--global','--name-only','--get-regexp','^includeif\\\\.gitdir'], capture_output=True, text=True).stdout
    for k in keys.splitlines():
        k = k.strip()
        if not k:
            continue
        p = re.sub('^includeif\\\\.gitdir(?:/i)?:', '', k, flags=re.I)
        p = re.sub('\\\\.path$', '', p, flags=re.I)
        if norm(p) == norm(pat):
            val = subprocess.run(['git','config','--global','--get',k], capture_output=True, text=True).stdout.strip()
            if val:
                removed_binding_files.append(val)
            subprocess.run(['git','config','--global','--unset-all',k], check=False, capture_output=True)

unset_matching_bindings()
subprocess.call(['git', 'config', '--global', inc_key, norm_cfg])
remaining = subprocess.run(['git','config','--global','--get-regexp','^includeif\\\\.gitdir'], capture_output=True, text=True).stdout
for old_file in removed_binding_files:
    if norm(old_file) not in norm(remaining) and os.path.exists(old_file):
        try:
            with open(old_file, encoding='utf-8-sig') as f: old_text = f.read()
            if re.search('git-account-switcher.*cred', old_text):
                os.remove(old_file)
        except OSError:
            pass

print(f\"\n[OK] Folder '{sys.argv[3]}' successfully bound to account '{match['label']}'!\")
print(f\"     All Git repositories inside will automatically commit & push as:\")
print(f\"     Name    : {match['name']}\")
print(f\"     Email   : {match['email']}\")
print(f\"     Username: {u} (auto-authenticated via gh token)\n\")
" "$target" "$pattern" "$resolved" "$SELF_SCRIPT"

    # Scan for existing repos with local overrides
    if [[ -d "$resolved" ]]; then
        local found_overrides=()
        if [[ -d "$resolved/.git" ]]; then
            local ln le
            ln=$(git -C "$resolved" config --local user.name 2>/dev/null || true)
            le=$(git -C "$resolved" config --local user.email 2>/dev/null || true)
            if [[ -n "$ln" || -n "$le" ]]; then
                found_overrides+=("$resolved|$ln|$le")
            fi
        else
            for sub in "$resolved"/*; do
                if [[ -d "$sub/.git" ]]; then
                    local sln sle
                    sln=$(git -C "$sub" config --local user.name 2>/dev/null || true)
                    sle=$(git -C "$sub" config --local user.email 2>/dev/null || true)
                    if [[ -n "$sln" || -n "$sle" ]]; then
                        found_overrides+=("$sub|$sln|$sle")
                    fi
                fi
            done
        fi
        if [[ ${#found_overrides[@]} -gt 0 ]]; then
            echo -e "\033[1;33m[NOTICE] Found ${#found_overrides[@]} repository(ies) with local (.git/config) overrides:\033[0m"
            for item in "${found_overrides[@]}"; do
                IFS='|' read -r rpath rname remail <<< "$item"
                echo -e "  - \033[0;33m$(basename "$rpath")\033[0m: user.name='$rname', user.email='$remail'"
            done
            echo -e "  \033[0;33mLocal overrides take precedence over folder bindings in Git.\033[0m"
            read -r -p "Would you like to clear local overrides in these repositories? [Y/n] " clean_choice
            if [[ -z "$clean_choice" || "$clean_choice" =~ ^[yY]$ ]]; then
                for item in "${found_overrides[@]}"; do
                    IFS='|' read -r rpath rname remail <<< "$item"
                    git -C "$rpath" config --local --unset-all user.name 2>/dev/null || true
                    git -C "$rpath" config --local --unset-all user.email 2>/dev/null || true
                    echo -e "  \033[0;32m[CLEARED] Cleared local override for $(basename "$rpath")\033[0m"
                done
            fi
        fi
    fi
}

unbind_folder() {
    local folder="$1"
    if [[ -z "$folder" ]]; then
        show_bindings
        read -r -p "Enter folder path to unbind (or Enter to cancel): " folder
    fi
    if [[ -z "$folder" ]]; then
        echo "Cancelled."
        return
    fi

    local resolved
    if command -v cygpath >/dev/null 2>&1; then
        resolved=$(cd "$folder" 2>/dev/null && cygpath -m "$(pwd)" || cygpath -m "$folder")
    elif (cd "$folder" 2>/dev/null && pwd -W) >/dev/null 2>&1; then
        resolved=$(cd "$folder" 2>/dev/null && pwd -W || echo "$folder")
    else
        resolved=$(cd "$folder" 2>/dev/null && pwd || echo "$folder")
    fi
    local pattern="${resolved%/}/"

    local found="false"
    local -a removed_cfgs=()
    while IFS= read -r k; do
        local k_clean
        k_clean=$(echo "$k" | sed -E 's/^includeif\.gitdir(\/i)?://; s/\.path$//')
        local k_norm="${k_clean%/}/" k_norm_lc pattern_lc
        k_norm_lc=$(to_lower "$k_norm")
        pattern_lc=$(to_lower "$pattern")
        if [[ "$k_norm_lc" == "$pattern_lc" ]]; then
            local cfg_path
            cfg_path=$(git config --global --get "$k" 2>/dev/null || true)
            [[ -n "$cfg_path" ]] && removed_cfgs+=("$cfg_path")
            git config --global --unset-all "$k" || true
            found="true"
        fi
    done < <(git config --global --name-only --get-regexp '^includeif\.gitdir' 2>/dev/null || true)

    local remaining
    remaining=$(git config --global --get-regexp '^includeif\.gitdir' 2>/dev/null || true)
    for cfg_path in "${removed_cfgs[@]}"; do
        if [[ -f "$cfg_path" ]] && grep -qE 'git-account-switcher.*cred' "$cfg_path" 2>/dev/null && [[ "$remaining" != *"$cfg_path"* ]]; then
            rm -f "$cfg_path"
            echo -e "  \033[0;32m[CLEAN] Removed generated profile config: $cfg_path\033[0m"
        fi
    done

    if [[ "$found" == "true" ]]; then
        echo -e "\n\033[0;32m[OK] Unbound folder '$resolved'.\033[0m\n"
    else
        echo -e "\n\033[1;33m[WARNING] No binding found matching '$resolved'.\033[0m\n"
    fi
}

show_bindings() {
    echo ""
    echo -e "\033[1;33mConfigured Folder Bindings (includeIf):\033[0m"
    echo "================================================================================"
    local found="false"
    while IFS= read -r line; do
        if [[ $line =~ includeif\.gitdir(/i)?:(.*)\.path=(.*) ]]; then
            local b_dir="${BASH_REMATCH[2]}"
            local b_cfg="${BASH_REMATCH[3]}"
            local b_acc=""
            if [[ "$b_cfg" =~ \.gitconfig-(.+) ]]; then
                b_acc="${BASH_REMATCH[1]}"
            fi
            echo -e "  Folder  : \033[0;32m$b_dir\033[0m"
            if [[ -n "$b_acc" ]]; then
                echo -e "  Account : \033[0;33m$b_acc\033[0m"
            fi
            echo -e "  Config  : \033[0;36m$b_cfg\033[0m"
            echo ""
            found="true"
        fi
    done < <(git config --global --list --show-origin 2>/dev/null | grep -E 'includeif\.gitdir' || true)

    if [[ "$found" == "false" ]]; then
        echo "  No folder bindings configured."
        echo "  Use 'gswitch bind <folder> <account>' to bind a folder to an account."
    fi
    echo "================================================================================"
    echo ""
}

doctor() {
    echo ""
    echo "============================================================"
    echo "  GIT ACCOUNT SWITCHER - SYSTEM & REPO DIAGNOSTICS (DOCTOR)  "
    echo "============================================================"
    local issue_count=0
    local warn_count=0

    echo ""
    echo -e "\033[1;33m[1/5] Checking Git toolchain...\033[0m"
    if command -v git >/dev/null 2>&1; then
        local git_ver git_num
        git_ver=$(git --version 2>/dev/null | sed 's/git version //')
        git_num="${git_ver%% *}"
        echo -e "  \033[0;32m[PASS] Git executable found : $(command -v git)\033[0m"
        echo -e "         Version              : $git_ver"
        if ! awk -v v="$git_num" 'BEGIN { split(v,a,"."); exit !(a[1] > 2 || (a[1] == 2 && a[2] >= 13)) }'; then
            echo -e "  \033[1;33m[WARN] Git >= 2.13 is recommended; found $git_ver.\033[0m"
            ((warn_count++)) || true
        fi
    else
        echo -e "  \033[0;31m[FAIL] Git executable not found in PATH.\033[0m"
        ((issue_count++)) || true
    fi

    echo ""
    echo -e "\033[1;33m[2/5] Checking GitHub CLI (gh)...\033[0m"
    if command -v gh >/dev/null 2>&1; then
        local gh_ver
        gh_ver=$(gh --version 2>/dev/null | head -n 1 | sed 's/gh version //')
        echo -e "  \033[0;32m[PASS] GitHub CLI found     : $(command -v gh)\033[0m"
        echo -e "         Version              : $gh_ver"
    else
        echo -e "  \033[0;31m[FAIL] GitHub CLI (gh) not found in PATH.\033[0m"
        ((issue_count++)) || true
    fi

    echo ""
    echo -e "\033[1;33m[3/5] Checking account profiles & authentication tokens...\033[0m"
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo -e "  \033[1;33m[WARN] Configuration file not found: $CONFIG_FILE\033[0m"
        ((warn_count++)) || true
    else
        if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
            echo -e "  \033[1;33m[WARN] Python 3 not found; cannot verify profile tokens.\033[0m"
            ((warn_count++)) || true
        else
        "$PYTHON_BIN" -c "
import json, os, subprocess, sys
cfg = os.environ['GIT_ACCOUNT_SWITCHER_CONFIG']
try:
    with open(cfg, encoding='utf-8-sig') as f:
        accs = json.load(f)
    print(f'  Found {len(accs)} account profile(s) in {cfg}:')
    warns = 0
    for a in accs:
        u = a.get('username', '')
        lbl = a.get('label', u)
        token_ok = False
        try:
            res = subprocess.run(['gh', 'auth', 'token', '-u', u], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if res.returncode == 0 and res.stdout.strip():
                token_ok = True
        except Exception:
            pass
        if token_ok:
            print(f'  \033[0;32m[PASS] Profile \'{lbl}\' ({u}): Valid OAuth token\033[0m')
        else:
            print(f'  \033[1;33m[WARN] Profile \'{lbl}\' ({u}): Token missing or expired\033[0m')
            warns += 1
    sys.exit(warns)
except Exception as e:
    print(f'  \033[0;31m[FAIL] Error reading {cfg}: {e}\033[0m')
    sys.exit(99)
" 2>/dev/null
        local py_status=$?
        if [[ $py_status -eq 99 ]]; then
            ((issue_count++)) || true
        elif [[ $py_status -gt 0 ]]; then
            ((warn_count += py_status)) || true
        fi
        fi
    fi

    echo ""
    echo -e "\033[1;33m[4/5] Checking folder bindings (includeIf)...\033[0m"
    local binding_lines
    binding_lines=$(git config --global --list --show-origin 2>/dev/null | grep -E 'includeif\.gitdir' || true)
    if [[ -z "$binding_lines" ]]; then
        echo -e "  [INFO] No folder bindings configured in ~/.gitconfig."
    else
        while IFS= read -r line; do
            if [[ "$line" =~ includeif\.gitdir(/i)?:(.*)\.path=(.*) ]]; then
                local b_dir="${BASH_REMATCH[2]}"
                local inc_file="${BASH_REMATCH[3]}"
                local clean_dir="${b_dir%/}"
                local dir_ok=0
                local file_ok=0
                [[ -d "$clean_dir" ]] && dir_ok=1
                [[ -f "$inc_file" ]] && file_ok=1
                
                if [[ $dir_ok -eq 1 && $file_ok -eq 1 ]]; then
                    echo -e "  \033[0;32m[PASS] Binding: $b_dir -> $inc_file\033[0m"
                    local helper_cfg
                    helper_cfg=$(git config -f "$inc_file" --get credential.https://github.com.helper 2>/dev/null || true)
                    if [[ "$helper_cfg" =~ git-account-switcher.*cred ]]; then
                        echo -e "         Credential Helper: Configured ($helper_cfg)"
                    else
                        echo -e "  \033[1;33m[WARN] Credential helper missing in $inc_file\033[0m"
                        ((warn_count++)) || true
                    fi
                else
                    if [[ $dir_ok -eq 0 ]]; then
                        echo -e "  \033[1;33m[WARN] Bound directory does not exist: $clean_dir\033[0m"
                        ((warn_count++)) || true
                    fi
                    if [[ $file_ok -eq 0 ]]; then
                        echo -e "  \033[0;31m[FAIL] Included file missing: $inc_file\033[0m"
                        ((issue_count++)) || true
                    fi
                fi
            fi
        done <<< "$binding_lines"
    fi

    echo ""
    echo -e "\033[1;33m[5/5] Checking current repository state...\033[0m"
    local is_repo
    is_repo=$(git rev-parse --is-inside-work-tree 2>/dev/null || echo "false")
    if [[ "$is_repo" == "true" ]]; then
        local eff_name eff_email eff_sign remote_url
        eff_name=$(git config user.name 2>/dev/null || echo "")
        eff_email=$(git config user.email 2>/dev/null || echo "")
        eff_sign=$(git config user.signingkey 2>/dev/null || echo "")
        remote_url=$(git config --get remote.origin.url 2>/dev/null || echo "")
        echo -e "  \033[0;32m[PASS] Inside Git repository: $(pwd)\033[0m"
        echo -e "         Active User Name  : $eff_name"
        echo -e "         Active User Email : $eff_email"
        if [[ -n "$eff_sign" ]]; then
            echo -e "         Active Signing Key: $eff_sign"
        fi
        if [[ -n "$remote_url" ]]; then
            echo -e "         Remote Origin URL : $remote_url"
            case "$remote_url" in
                git@github.com:*|ssh://*)
                    echo -e "  \033[1;33m[WARN] Repository uses SSH remote ($remote_url).\033[0m"
                    echo -e "         Git credential helper is bypassed for SSH transport."
                    echo -e "         To enable HTTPS token switching: git remote set-url origin https://github.com/<org>/<repo>.git"
                    ((warn_count++)) || true
                    ;;
                *)
                    echo -e "  \033[0;32m[PASS] Remote uses HTTPS transport (credential helper active)\033[0m"
                    ;;
            esac
        fi

        local loc_name loc_email
        loc_name=$(git config --local user.name 2>/dev/null || true)
        loc_email=$(git config --local user.email 2>/dev/null || true)
        if [[ -n "$loc_name" || -n "$loc_email" ]]; then
            local curr_p shadowed="false"
            if command -v cygpath >/dev/null 2>&1; then
                curr_p=$(cygpath -m "$(pwd)")
            elif (pwd -W) >/dev/null 2>&1; then
                curr_p=$(pwd -W)
            else
                curr_p=$(pwd)
            fi
            curr_p="${curr_p%/}/"
            while IFS= read -r bline; do
                if [[ $bline =~ includeif\.gitdir(/i)?:(.*)\.path=(.*) ]]; then
                    local cb="${BASH_REMATCH[2]%/}/" curr_p_lc cb_lc
                    curr_p_lc=$(to_lower "$curr_p")
                    cb_lc=$(to_lower "$cb")
                    if [[ "$curr_p_lc" == "$cb_lc"* ]]; then
                        shadowed="true"
                        echo -e "  \033[1;33m[WARN] Local repository override active ($loc_name <$loc_email>) in a bound directory!\033[0m"
                        echo -e "         This repo will NOT inherit folder binding '${BASH_REMATCH[2]}' until cleared."
                        echo -e "         To inherit folder account: git config --local --unset-all user.name && git config --local --unset-all user.email"
                        ((warn_count++)) || true
                        break
                    fi
                fi
            done <<< "$binding_lines"
            if [[ "$shadowed" == "false" ]]; then
                echo -e "  [INFO] Local repository override active ($loc_name <$loc_email>)"
            fi
        fi

        local local_helpers last_helper helper_script has_reset="false"
        local_helpers=$(git config --local --get-all credential.https://github.com.helper 2>/dev/null || true)
        if [[ -n "$local_helpers" ]]; then
            while IFS= read -r hl; do
                [[ -z "$hl" ]] && has_reset="true"
            done <<< "$local_helpers"
            if [[ "$has_reset" == "false" ]] && [[ -n "$(git config --global --get-all credential.https://github.com.helper 2>/dev/null || true)" ]]; then
                echo -e "  \033[1;33m[WARN] Local credential helper has no empty reset; a global Git helper may win.\033[0m"
                echo -e "         Re-run 'gswitch -l <account>' to repair credential isolation."
                ((warn_count++)) || true
            fi
            last_helper=$(printf '%s\n' "$local_helpers" | tail -n 1)
            if [[ "$last_helper" =~ git-account-switcher.*cred ]]; then
                helper_script=$(printf '%s' "$last_helper" | sed -E "s/^!'([^']+)' cred .*/\1/")
                if [[ "$helper_script" == "$last_helper" || ! -f "$helper_script" ]]; then
                    echo -e "  \033[1;33m[WARN] Local credential helper script is missing or uses a bare command: $last_helper\033[0m"
                    echo -e "         Re-run 'gswitch -l <account>' after installing the helper."
                    ((warn_count++)) || true
                fi
            fi
        fi
    else
        echo -e "  [INFO] Current directory is not a Git repository."
    fi

    echo ""
    echo "============================================================"
    if [[ $issue_count -eq 0 && $warn_count -eq 0 ]]; then
        echo -e "  \033[0;32mDOCTOR RESULT: ALL CHECKS PASSED [OK]\033[0m"
    elif [[ $issue_count -eq 0 ]]; then
        echo -e "  \033[1;33mDOCTOR RESULT: $warn_count WARNING(S) FOUND (SYSTEM OPERATIONAL)\033[0m"
    else
        echo -e "  \033[0;31mDOCTOR RESULT: $issue_count ISSUE(S), $warn_count WARNING(S) FOUND\033[0m"
    fi
    echo "============================================================"
    echo ""
    [[ $issue_count -eq 0 ]] && return 0 || return 1
}

release_latest_tag() {
    gh release view --repo "$RELEASES_REPO" --json tagName --jq '.tagName' 2>/dev/null || true
}

release_verify_dir() {
    local dir="$1"
    if ! command -v gh >/dev/null 2>&1; then
        echo -e "\033[0;31m[ERROR] GitHub CLI (gh) is required to verify releases.\033[0m" >&2
        return 1
    fi
    if [[ ! -f "$dir/SHA256SUMS" ]]; then
        echo -e "\033[0;31m[ERROR] Release is missing SHA256SUMS.\033[0m" >&2
        return 1
    fi
    if ! gh attestation verify "$dir/SHA256SUMS" --repo "$RELEASES_REPO" --signer-workflow "$RELEASE_WORKFLOW" --deny-self-hosted-runners >/dev/null 2>&1; then
        echo -e "\033[0;31m[ERROR] Release attestation verification failed.\033[0m" >&2
        return 1
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        (cd "$dir" && sha256sum -c SHA256SUMS >/dev/null 2>&1) || {
            echo -e "\033[0;31m[ERROR] Release checksum verification failed.\033[0m" >&2
            return 1
        }
    elif command -v shasum >/dev/null 2>&1; then
        (cd "$dir" && shasum -a 256 -c SHA256SUMS >/dev/null 2>&1) || {
            echo -e "\033[0;31m[ERROR] Release checksum verification failed.\033[0m" >&2
            return 1
        }
    else
        echo -e "\033[0;31m[ERROR] sha256sum or shasum is required to verify releases.\033[0m" >&2
        return 1
    fi
    return 0
}

update_gswitch() {
    echo ""
    echo "============================================================"
    echo -e " \033[0;36mUpdating git-account-switcher (gswitch)\033[0m"
    echo -e " \033[0;34mCurrent Version: v$SCRIPT_VERSION\033[0m"
    echo "============================================================"
    echo ""

    local bin_dir="$GSWITCH_HOME/.local/bin"
    mkdir -p "$bin_dir"

    local is_local=false
    local script_dir=""
    if [[ -n "${BASH_SOURCE[0]}" && -f "$(dirname "${BASH_SOURCE[0]}")/git-account-switcher" ]]; then
        script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if [[ -f "$script_dir/../install.sh" ]]; then
            is_local=true
        fi
    fi

    local files=("git-account-switcher" "gswitch" "switch-git")
    if [[ "$is_local" == "true" ]]; then
        for f in "${files[@]}"; do
            if [[ -f "$script_dir/$f" ]]; then
                cp "$script_dir/$f" "$bin_dir/.$f.new.$$"
                chmod +x "$bin_dir/.$f.new.$$"
                mv -f "$bin_dir/.$f.new.$$" "$bin_dir/$f"
                echo -e "  \033[0;32m[OK] Updated $f (local source)\033[0m"
            fi
        done
    else
        local tag="${GSWITCH_UPDATE_TAG:-$(release_latest_tag)}"
        if [[ -z "$tag" ]]; then
            echo -e "\033[0;31m[ERROR] No GitHub release found for $RELEASES_REPO.\033[0m" >&2
            echo "        Create a v* release with attested assets, or set GSWITCH_UPDATE_TAG." >&2
            return 1
        fi
        echo "Downloading verified release $tag..."
        local tmp
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/gswitch-update.XXXXXX") || return 1
        if ! gh release download "$tag" --repo "$RELEASES_REPO" --dir "$tmp" --clobber >/dev/null 2>&1; then
            echo -e "\033[0;31m[ERROR] Failed to download release $tag.\033[0m" >&2
            rm -rf "$tmp"
            return 1
        fi
        if ! release_verify_dir "$tmp"; then
            rm -rf "$tmp"
            return 1
        fi
        local version="${tag#v}"
        local stage="gswitch-v$version"
        if ! tar -xzf "$tmp/$stage.tar.gz" -C "$tmp" 2>/dev/null; then
            echo -e "\033[0;31m[ERROR] Failed to extract release archive.\033[0m" >&2
            rm -rf "$tmp"
            return 1
        fi

        local failed=0
        for f in "${files[@]}"; do
            if [[ -f "$bin_dir/$f" ]]; then
                cp "$bin_dir/$f" "$tmp/backup-$f" 2>/dev/null || true
            fi
            if ! cp "$tmp/$stage/bin/$f" "$bin_dir/.$f.new.$$" 2>/dev/null; then
                failed=1
                break
            fi
            chmod +x "$bin_dir/.$f.new.$$" 2>/dev/null || true
            if ! mv -f "$bin_dir/.$f.new.$$" "$bin_dir/$f" 2>/dev/null; then
                failed=1
                break
            fi
            echo -e "  \033[0;32m[OK] Verified & updated $f\033[0m"
        done
        if [[ "$failed" -ne 0 ]]; then
            echo -e "\033[0;31m[ERROR] Update failed; restoring previous files.\033[0m" >&2
            for f in "${files[@]}"; do
                [[ -f "$tmp/backup-$f" ]] && cp "$tmp/backup-$f" "$bin_dir/$f" 2>/dev/null || true
            done
            rm -rf "$tmp"
            return 1
        fi
        rm -rf "$tmp"
        echo -e "  \033[0;32m[OK] Attestation, checksums, and atomic replacement verified for $tag\033[0m"
    fi

    git config --global alias.who "!git-account-switcher status" 2>/dev/null || true
    git config --global alias.switch-acc "!git-account-switcher" 2>/dev/null || true

    echo ""
    echo -e "\033[0;32m[OK] git-account-switcher updated successfully! (v$SCRIPT_VERSION)\033[0m"
    echo -e "\033[0;36m     Your configuration ($CONFIG_FILE) and folder bindings remain safe and intact.\033[0m"
    echo ""
}

get_bash_completion_script() {
    cat << 'EOF'
_gswitch_completions() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion || return
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    fi

    local subcommands="status who list ls doctor check bind unbind bindings sync setup add remove rm alias unalias edit config update upgrade version completion help -l --local -g --global -f --force -v -h"
    local cfg="${GIT_ACCOUNT_SWITCHER_CONFIG:-${GIT_ACCOUNT_SWITCHER_HOME:-$HOME}/.config/git-account-switcher/accounts.json}"
    local acc_keys=""

    if [[ -f "$cfg" ]] && command -v python3 >/dev/null 2>&1; then
        acc_keys=$(GSWITCH_COMPLETION_CFG="$cfg" python3 -c "
import json, os
try:
    with open(os.environ['GSWITCH_COMPLETION_CFG'], encoding='utf-8-sig') as f:
        data = json.load(f)
    keys = []
    for a in data:
        if a.get('key'): keys.append(a['key'])
        if a.get('username') and a['username'] not in keys: keys.append(a['username'])
        for al in a.get('aliases', []):
            if not str(al).isdigit() and al not in keys: keys.append(str(al))
    print(' '.join(keys))
except:
    pass
" 2>/dev/null || true)
    fi

    if [[ "$COMP_CWORD" -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$subcommands $acc_keys" -- "$cur") )
        return 0
    fi

    case "$prev" in
        -l|--local|remove|rm|delete|alias|unalias)
            COMPREPLY=( $(compgen -W "$acc_keys" -- "$cur") )
            return 0
            ;;
        completion)
            COMPREPLY=( $(compgen -W "bash zsh powershell install" -- "$cur") )
            return 0
            ;;
        bind)
            compopt -o filenames 2>/dev/null || true
            COMPREPLY=( $(compgen -d -- "$cur") )
            return 0
            ;;
        *)
            if [[ "${COMP_WORDS[1]}" == "bind" && "$COMP_CWORD" -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "$acc_keys" -- "$cur") )
                return 0
            fi
            ;;
    esac
}
complete -F _gswitch_completions gswitch git-account-switcher switch-git
EOF
}

get_zsh_completion_script() {
    cat << 'EOF'
#compdef gswitch git-account-switcher switch-git
autoload -U +X bashcompinit && bashcompinit
_gswitch_completions() {
    local cur prev words cword
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local subcommands="status who list ls doctor check bind unbind bindings sync setup add remove rm alias unalias edit config update upgrade version completion help -l --local -g --global -f --force -v -h"
    local cfg="${GIT_ACCOUNT_SWITCHER_CONFIG:-${GIT_ACCOUNT_SWITCHER_HOME:-$HOME}/.config/git-account-switcher/accounts.json}"
    local acc_keys=""

    if [[ -f "$cfg" ]] && command -v python3 >/dev/null 2>&1; then
        acc_keys=$(GSWITCH_COMPLETION_CFG="$cfg" python3 -c "
import json, os
try:
    with open(os.environ['GSWITCH_COMPLETION_CFG'], encoding='utf-8-sig') as f:
        data = json.load(f)
    keys = []
    for a in data:
        if a.get('key'): keys.append(a['key'])
        if a.get('username') and a['username'] not in keys: keys.append(a['username'])
        for al in a.get('aliases', []):
            if not str(al).isdigit() and al not in keys: keys.append(str(al))
    print(' '.join(keys))
except:
    pass
" 2>/dev/null || true)
    fi

    if [[ "$COMP_CWORD" -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$subcommands $acc_keys" -- "$cur") )
        return 0
    fi

    case "$prev" in
        -l|--local|remove|rm|delete|alias|unalias)
            COMPREPLY=( $(compgen -W "$acc_keys" -- "$cur") )
            return 0
            ;;
        completion)
            COMPREPLY=( $(compgen -W "bash zsh powershell install" -- "$cur") )
            return 0
            ;;
        bind)
            COMPREPLY=( $(compgen -d -- "$cur") )
            return 0
            ;;
        *)
            if [[ "${COMP_WORDS[1]}" == "bind" && "$COMP_CWORD" -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "$acc_keys" -- "$cur") )
                return 0
            fi
            ;;
    esac
}
complete -F _gswitch_completions gswitch git-account-switcher switch-git
EOF
}

handle_completion() {
    local target="$1"
    if [[ "$target" == "zsh" ]]; then
        get_zsh_completion_script
        return
    elif [[ "$target" == "bash" || -z "$target" ]]; then
        get_bash_completion_script
        return
    elif [[ "$target" == "install" ]]; then
        echo ""
        echo "Installing shell auto-completion for git-account-switcher..."
        mkdir -p "$CONFIG_DIR"
        local comp_file="$CONFIG_DIR/completion.bash"
        get_bash_completion_script > "$comp_file"
        echo "  [OK] Generated completion script -> $comp_file"

        local bashrc="$GSWITCH_HOME/.bashrc"
        local include_line="[[ -f \"$comp_file\" ]] && source \"$comp_file\""
        if [[ -f "$bashrc" ]]; then
            if ! grep -q "$comp_file" "$bashrc" 2>/dev/null; then
                echo -e "\n# git-account-switcher shell completion\n$include_line" >> "$bashrc"
                echo "  [OK] Added completion loader to $bashrc"
            else
                echo "  [OK] $bashrc is already configured."
            fi
        fi

        local zshrc="$GSWITCH_HOME/.zshrc"
        if [[ -f "$zshrc" ]]; then
            local zcomp_file="$CONFIG_DIR/completion.zsh"
            get_zsh_completion_script > "$zcomp_file"
            local zinclude="[[ -f \"$zcomp_file\" ]] && source \"$zcomp_file\""
            if ! grep -q "$zcomp_file" "$zshrc" 2>/dev/null; then
                echo -e "\n# git-account-switcher shell completion\n$zinclude" >> "$zshrc"
                echo "  [OK] Added completion loader to $zshrc"
            fi
        fi

        echo ""
        echo -e "\033[0;32m[OK] Shell auto-completion successfully installed!\033[0m"
        echo -e "\033[0;36m     Restart your shell or run: source ~/.bashrc (or ~/.zshrc)\033[0m"
        echo ""
        return
    fi
    echo -e "\033[0;31m[ERROR] Unknown completion target: '$target'. Supported: bash, zsh, install\033[0m"
}

show_help() {
    echo ""
    echo "============================================================"
    echo -e " \033[0;36mgit-account-switcher (gswitch) ⚡\033[0m"
    echo -e " \033[0;34mFast Multi-Account GitHub & Git Identity Switcher\033[0m"
    echo "============================================================"
    echo ""
    echo -e "\033[1;33mUSAGE:\033[0m"
    echo "  gswitch [account]                   Switch account globally (by key, username, alias, or index)"
    echo "  gswitch -l [account]                Switch account locally (current repository only)"
    echo "  gswitch --clear-local [account]     Switch globally and clear shadowing repo-local overrides"
    echo "  gswitch                             Open interactive account selection menu"
    echo "  gswitch status | who                View active GitHub token & Git identities"
    echo "  gswitch list | ls                   List all configured account profiles with aliases"
    echo "  gswitch doctor | check              Run system & repository diagnostic health checks"
    echo "  gswitch update | upgrade            Update git-account-switcher to latest version"
    echo "  gswitch version | -v                Display installed version"
    echo "  gswitch alias [acc] [shortcut]      Add or view shortcut aliases for quick switching"
    echo "  gswitch unalias [acc] [alias]       Remove a shortcut alias from an account profile"
    echo "  gswitch bind [dir] [account]        Permanently bind an entire folder to an account"
    echo "  gswitch unbind [dir]                Remove a folder binding"
    echo "  gswitch bindings                    List all active folder bindings (includeIf)"
    echo "  gswitch edit | config               Open accounts.json in VS Code / default editor"
    echo "  gswitch sync                        Auto-discover & sync accounts from GitHub CLI"
    echo "  gswitch setup                       Launch interactive first-time setup wizard"
    echo "  gswitch add [user] [key] [name] [email]  Add or update an account profile"
    echo "  gswitch remove [key] [-f]           Remove an account profile and re-index list"
    echo "  gswitch help                        Display this help message"
    echo ""
    echo -e "\033[1;33mCOMMANDS:\033[0m"
    echo "  add      Add a new profile interactively or via args: gswitch add <user> <key> [name] [email]"
    echo "  alias    Add shortcut alias: gswitch alias <acc> <shortcut> (or list all if no args)"
    echo "  unalias  Remove shortcut alias: gswitch unalias <acc> <shortcut>"
    echo "  bind     Bind a directory to an account (includeIf): gswitch bind <dir> <account>"
    echo "  unbind   Remove a folder binding: gswitch unbind <dir>"
    echo "  bindings List all active directory bindings configured on system"
    echo "  doctor   Run complete self-diagnostics on Git, GitHub CLI, tokens, bindings, and remotes"
    echo "  edit     Open accounts.json directly in VS Code / default editor"
    echo "  remove   Remove a profile by key, user, alias, or index: gswitch remove <key> [-f]"
    echo "  sync     Scan 'gh auth status', fetch IDs, and configure private noreply emails"
    echo "  setup    Launch the first-time guided setup wizard"
    echo "  status   Display active GitHub CLI user and global/local Git user.name & email"
    echo "  list     Display formatted table of all configured profiles with * ACTIVE badge"
    echo "  update   Download and install latest release of git-account-switcher"
    echo "  version  Display installed version: gswitch version / gswitch -v"
    echo "  completion Install or output tab auto-completion: gswitch completion [install|bash|zsh]"
    echo ""
    echo -e "\033[1;33mFLAGS:\033[0m"
    echo "  -l, --local                         Scope changes to current repository only (.git/config)"
    echo "  -g, --global                        Scope changes system-wide (default)"
    echo "  -c, --clear-local                   When switching globally, remove shadowing repo-local overrides"
    echo "  -f, --force                         Force action without interactive confirmation"
    echo "  -h, --help                          Show detailed help information"
    echo ""
    echo -e "\033[1;33mEXAMPLES:\033[0m"
    echo "  gswitch personal                    # Switch to 'personal' profile globally"
    echo "  gswitch work                        # Switch to 'work' profile globally"
    echo "  gswitch 1                           # Switch to profile #1"
    echo "  gswitch -l work                     # Apply 'work' author & push token to THIS repository only"
    echo "  gswitch --clear-local personal      # Switch globally and remove stale repo-local overrides"
    echo "  gswitch alias work w                # Add shortcut alias 'w' to work account"
    echo "  gswitch unalias work w              # Remove shortcut alias 'w' from work"
    echo "  gswitch bind ~/work work            # All repos in ~/work commit as work"
    echo "  gswitch unbind ~/work               # Remove folder binding"
    echo "  gswitch bindings                    # View all active folder bindings"
    echo "  gswitch edit                        # Open accounts.json in editor"
    echo "  gswitch sync                        # Auto-import all accounts from 'gh auth status'"
    echo "  gswitch add                         # Add a new account interactively"
    echo "  gswitch add octocat work            # Add 'octocat' with key 'work' non-interactively"
    echo "  gswitch remove work                 # Remove the 'work' account profile"
    echo "  gswitch remove 2 -f                 # Force remove account #2 without confirmation"
    echo "  gswitch update                      # Update gswitch to latest version"
    echo "  gswitch version                     # Show installed version (e.g. v$SCRIPT_VERSION)"
    echo "  gswitch completion install          # Install shell tab auto-completion to profile"
    echo "  git who                             # Fast alias to inspect current identity"
    echo ""
    echo -e "\033[1;33mCONFIG PATH:\033[0m"
    echo -e "  \033[0;36m$CONFIG_FILE\033[0m"
    echo ""
}

setup_wizard() {
    echo ""
    echo "============================================================"
    echo " git-account-switcher Setup Wizard"
    echo "============================================================"
    if gh auth status 2>&1 | grep -q 'Logged in to .* account'; then
        read -r -p "Found logged-in accounts in GitHub CLI. Auto-import them now? [Y/n]: " AUTO
        if [[ -z "$AUTO" || "$AUTO" =~ ^[yY]$ ]]; then
            sync_from_gh
            return
        fi
    fi

    while true; do
        add_account
        read -r -p "Add another account? [y/N]: " MORE
        if [[ "$MORE" != [yY]* ]]; then
            break
        fi
    done
}

switch_account() {
    local label="$1"
    local username="$2"
    local name="$3"
    local email="$4"
    local is_local="$5"
    local signingkey="$6"

    local is_repo
    is_repo=$(git rev-parse --is-inside-work-tree 2>/dev/null || echo "false")

    if [[ "$is_local" == "true" && "$is_repo" != "true" ]]; then
        echo -e "\033[0;31m[ERROR] Cannot apply --local: current directory is not a Git repository.\033[0m"
        return 1
    fi

    echo ""
    echo -e "\033[1;33m>> Switching to account: [$label] ($username)...\033[0m"

    if ! gh auth switch -u "$username"; then
        echo -e "\033[0;31m[ERROR] Failed to switch GitHub CLI to $username\033[0m"
        return 1
    fi

    if [[ "$is_local" == "true" ]]; then
        local github_helper gist_helper
        github_helper=$(cred_helper_command "$username")
        gist_helper="$github_helper"

        git config --local user.name "$name"
        git config --local user.email "$email"
        git config --local credential.https://github.com.username "$username"
        git config --local --unset-all credential.https://github.com.helper 2>/dev/null || true
        git config --local --add credential.https://github.com.helper ""
        git config --local --add credential.https://github.com.helper "$github_helper"
        git config --local credential.https://gist.github.com.username "$username"
        git config --local --unset-all credential.https://gist.github.com.helper 2>/dev/null || true
        git config --local --add credential.https://gist.github.com.helper ""
        git config --local --add credential.https://gist.github.com.helper "$gist_helper"

        if [[ -n "$signingkey" ]]; then
            git config --local user.signingkey "$signingkey"
            git config --local commit.gpgsign true
            [[ "$signingkey" =~ ^(ssh-|key::) ]] && git config --local gpg.format ssh
            echo -e "\033[0;32m[OK] Git signingkey (LOCAL) : $signingkey\033[0m"
        else
            git config --local --unset-all user.signingkey 2>/dev/null || true
            git config --local --unset-all commit.gpgsign 2>/dev/null || true
            git config --local --unset-all gpg.format 2>/dev/null || true
        fi

        echo -e "\033[0;32m[OK] GitHub CLI switched to : $username\033[0m"
        echo -e "\033[0;32m[OK] Git user.name (LOCAL)  : $name\033[0m"
        echo -e "\033[0;32m[OK] Git user.email (LOCAL) : $email\033[0m"
        echo -e "\033[0;32m[OK] Git cred helper (LOCAL): $github_helper\033[0m"
        echo ""
        echo -e "\033[0;36m=> Applied locally with isolated push permissions for this repository only!\033[0m"
    else
        if [[ "$is_repo" == "true" ]]; then
            local has_local_name has_local_cred has_local_sign
            has_local_name=$(git config --local user.name 2>/dev/null || true)
            has_local_cred=$(git config --local credential.https://github.com.username 2>/dev/null || true)
            has_local_sign=$(git config --local user.signingkey 2>/dev/null || true)
            if [[ -n "$has_local_name" || -n "$has_local_cred" || -n "$has_local_sign" ]]; then
                if [[ "${CLEAR_LOCAL:-false}" == "true" ]]; then
                    git config --local --unset-all user.name 2>/dev/null || true
                    git config --local --unset-all user.email 2>/dev/null || true
                    git config --local --unset-all credential.https://github.com.username 2>/dev/null || true
                    git config --local --unset-all credential.https://github.com.helper 2>/dev/null || true
                    git config --local --unset-all credential.https://gist.github.com.username 2>/dev/null || true
                    git config --local --unset-all credential.https://gist.github.com.helper 2>/dev/null || true
                    git config --local --unset-all user.signingkey 2>/dev/null || true
                    git config --local --unset-all commit.gpgsign 2>/dev/null || true
                    git config --local --unset-all gpg.format 2>/dev/null || true
                    echo -e "\033[1;33m[INFO] Cleared repository-local overrides in current repository.\033[0m"
                else
                    echo -e "\033[1;33m[INFO] Repository-local overrides are active and were left untouched.\033[0m"
                    echo -e "       They continue to shadow global settings in this repository."
                    echo -e "       Use 'gswitch -l <account>' to update them, or 'gswitch --clear-local <account>' to remove them."
                fi
            fi
        fi

        git config --global user.name "$name"
        git config --global user.email "$email"
        if [[ -n "$signingkey" ]]; then
            git config --global user.signingkey "$signingkey"
            git config --global commit.gpgsign true
            [[ "$signingkey" =~ ^(ssh-|key::) ]] && git config --global gpg.format ssh
            echo -e "\033[0;32m[OK] Git signingkey (GLOBAL): $signingkey\033[0m"
        else
            git config --global --unset-all user.signingkey 2>/dev/null || true
            git config --global --unset-all commit.gpgsign 2>/dev/null || true
            git config --global --unset-all gpg.format 2>/dev/null || true
        fi

        echo -e "\033[0;32m[OK] GitHub CLI switched to : $username\033[0m"
        echo -e "\033[0;32m[OK] Git user.name (GLOBAL) : $name\033[0m"
        echo -e "\033[0;32m[OK] Git user.email (GLOBAL): $email\033[0m"
        echo ""
        echo -e "\033[0;36m=> Ready to commit & push as $label!\033[0m"
    fi
    echo ""
}

# Process flags
APPLY_LOCAL="false"
CLEAR_LOCAL="false"
TARGET=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -l|--local)
            APPLY_LOCAL="true"
            shift
            ;;
        -g|--global)
            APPLY_LOCAL="false"
            shift
            ;;
        -c|--clear-local)
            CLEAR_LOCAL="true"
            shift
            ;;
        status|who|current|-s)
            show_status
            exit 0
            ;;
        doctor|check|diag|diagnose)
            doctor
            exit $?
            ;;
        list|ls)
            show_list
            exit 0
            ;;
        sync|import)
            sync_from_gh
            exit 0
            ;;
        setup|init)
            setup_wizard
            exit 0
            ;;
        add)
            shift
            add_account "$@"
            exit 0
            ;;
        alias|aliases|shortcut)
            shift
            if [[ $# -eq 0 ]]; then
                show_list
                exit 0
            fi
            alias_account "$1" "$2"
            exit 0
            ;;
        unalias|rmalias)
            shift
            unalias_account "$1" "$2"
            exit 0
            ;;
        bind|folder|link)
            shift
            bind_folder "$1" "$2"
            exit 0
            ;;
        unbind|unlink)
            shift
            unbind_folder "$1"
            exit 0
            ;;
        bindings|folders|dirs)
            show_bindings
            exit 0
            ;;
        edit|config)
            edit_config
            exit 0
            ;;
        remove|rm|delete)
            shift
            FORCE="false"
            TARGET=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -f|--force|-y|--yes) FORCE="true" ;;
                    *) TARGET="$1" ;;
                esac
                shift
            done
            remove_account "$TARGET" "$FORCE"
            exit 0
            ;;
        version|-v|--version|-V)
            echo -e "\033[0;36mgit-account-switcher (gswitch) v$SCRIPT_VERSION\033[0m"
            exit 0
            ;;
        update|upgrade)
            update_gswitch
            exit 0
            ;;
        completion|completions|autocomplete)
            shift
            handle_completion "$1"
            exit 0
            ;;
        help|-h|--help)
            show_help
            exit 0
            ;;
        *)
            TARGET="$1"
            shift
            ;;
    esac
done

# If no config exists, prompt setup
if [[ ! -f "$CONFIG_FILE" ]]; then
    read -r -p "No accounts configured yet. Run setup wizard now? [Y/n]: " RUN_WIZ
    if [[ -z "$RUN_WIZ" || "$RUN_WIZ" =~ ^[yY]$ ]]; then
        setup_wizard
        exit 0
    else
        exit 0
    fi
fi

if [[ -z "$TARGET" ]]; then
    show_status
    show_list
    read -r -p "Select account, 's' to sync, 'a' to add, 'e' to edit, or Enter to cancel: " CHOICE
    if [[ "$CHOICE" =~ ^[sS]$ ]]; then
        sync_from_gh
        exit 0
    elif [[ "$CHOICE" =~ ^[aA]$ ]]; then
        add_account
        exit 0
    elif [[ "$CHOICE" =~ ^[eE]$ ]]; then
        edit_config
        exit 0
    elif [[ -n "$CHOICE" ]]; then
        TARGET="$CHOICE"
    else
        echo "Cancelled."
        exit 0
    fi
fi

# Find account in JSON with exact and fuzzy matching
require_python || exit 1
SELECTED=$("$PYTHON_BIN" -c "
import json, os, sys
q = sys.argv[1].lower()
with open(os.environ['GIT_ACCOUNT_SWITCHER_CONFIG'], encoding='utf-8-sig') as f:
    data = json.load(f)

# 1. Exact match
for a in data:
    aliases = [str(x).lower() for x in a.get('aliases', [])]
    if str(a.get('index')) == q or a.get('key','').lower() == q or a.get('username','').lower() == q or q in aliases:
        print(f\"{a.get('label')}\t{a.get('username')}\t{a.get('name')}\t{a.get('email')}\t{a.get('signingkey') or ''}\")
        sys.exit(0)

# 2. Fuzzy match (minimum 3 characters, part of username or key)
if len(q) >= 3:
    for a in data:
        u = a.get('username','').lower()
        k = a.get('key','').lower()
        if q in u or q in k:
            print(f\"{a.get('label')}\t{a.get('username')}\t{a.get('name')}\t{a.get('email')}\t{a.get('signingkey') or ''}\")
            sys.exit(0)
" "$TARGET" 2>/dev/null || true)

if [[ -n "$SELECTED" ]]; then
    IFS=$'\t' read -r S_LABEL S_USER S_NAME S_EMAIL S_SIGNKEY <<< "$SELECTED"
    switch_account "$S_LABEL" "$S_USER" "$S_NAME" "$S_EMAIL" "$APPLY_LOCAL" "$S_SIGNKEY" || exit 1
else
    echo -e "\033[0;31m[ERROR] Account '$TARGET' not found. Run 'gswitch list', 'gswitch add', or 'gswitch sync'.\033[0m"
    exit 1
fi
